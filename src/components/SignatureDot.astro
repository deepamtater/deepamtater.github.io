---
// The site's one moving mark: the full stop after "Dee Tater". It rests after
// the name (or the current section), slides to whichever nav link is hovered,
// carries across page loads as a view transition, and on a post docks to the
// top edge as a reading-progress marker.
---

<span class="signature-dot" aria-hidden="true"></span>

<script is:inline>
  (() => {
    const dot = document.querySelector('.signature-dot');
    const header = document.querySelector('.site-header');
    if (!dot || !header) return;
    const targets = [...header.querySelectorAll('[data-dot-target]')];
    const rest = header.querySelector('[data-dot-rest]') || targets[0];
    const article = document.querySelector('[data-article]');
    const BASE = 8;
    const descents = new Map();
    let hovered = null;
    let docked = false;

    const descentOf = (style) => {
      const font = `${style.fontWeight} 100px ${style.fontFamily}`;
      if (!descents.has(font)) {
        const ctx = document.createElement('canvas').getContext('2d');
        ctx.font = font;
        descents.set(font, ctx.measureText('x').fontBoundingBoxDescent / 100 || 0.25);
      }
      return descents.get(font);
    };

    // Just after the last glyph, sitting on the baseline like a full stop.
    const anchor = (el) => {
      const label = el.querySelector('.label') || el;
      const text = label.firstChild;
      if (!text || !text.textContent) return null;
      const range = document.createRange();
      range.setStart(text, text.textContent.length - 1);
      range.setEnd(text, text.textContent.length);
      const rect = range.getBoundingClientRect();
      const style = getComputedStyle(label);
      const fs = parseFloat(style.fontSize);
      const size = Math.max(4, fs * 0.2);
      const baseline = rect.bottom - descentOf(style) * fs;
      return { x: rect.right + fs * 0.08 + scrollX, y: baseline - size + scrollY, size };
    };

    const draw = ({ x, y, size }) => {
      dot.style.transform = `translate3d(${x}px, ${y}px, 0) scale(${size / BASE})`;
    };

    const snap = (fn) => {
      dot.classList.add('snap');
      fn();
      dot.getBoundingClientRect();
      requestAnimationFrame(() => dot.classList.remove('snap'));
    };

    const progress = () => {
      const r = article.getBoundingClientRect();
      const travel = Math.max(1, r.height - innerHeight * 0.6);
      const p = Math.min(1, Math.max(0, -r.top / travel));
      return { x: r.left + p * r.width, y: 10, size: 6 };
    };

    const update = () => {
      const shouldDock = !!article && header.getBoundingClientRect().bottom < 0;
      if (shouldDock !== docked) {
        docked = shouldDock;
        snap(() => {
          dot.classList.toggle('docked', docked);
          draw(docked ? progress() : anchor(hovered || rest));
        });
        return;
      }
      if (docked) draw(progress());
    };

    const settle = () => {
      if (docked) return draw(progress());
      const pos = anchor(hovered || rest);
      if (pos) draw(pos);
    };

    snap(settle);
    document.documentElement.classList.add('has-dot');
    document.fonts.ready.then(() => snap(settle));
    addEventListener('resize', () => snap(settle));

    for (const el of targets) {
      const on = () => {
        hovered = el;
        settle();
      };
      const off = () => {
        hovered = null;
        settle();
      };
      el.addEventListener('pointerenter', on);
      el.addEventListener('pointerleave', off);
      el.addEventListener('focus', on);
      el.addEventListener('blur', off);
    }

    if (article) {
      let queued = false;
      addEventListener(
        'scroll',
        () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(() => {
            queued = false;
            update();
          });
        },
        { passive: true },
      );
      update();
    }
  })();
</script>

<style is:global>
  .signature-dot {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 20;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    transform-origin: 0 0;
    transform: translate3d(-100px, -100px, 0);
    transition: transform var(--duration-medium) var(--ease);
    view-transition-name: signature-dot;
    pointer-events: none;
  }

  .signature-dot.snap,
  .signature-dot.docked {
    transition: none;
  }

  .signature-dot.docked {
    position: fixed;
    animation: dot-dock var(--duration-medium) var(--ease) both;
  }

  @keyframes dot-dock {
    from {
      opacity: 0;
    }
  }

  ::view-transition-group(signature-dot) {
    animation-duration: var(--duration-medium);
    animation-timing-function: var(--ease);
  }
</style>
