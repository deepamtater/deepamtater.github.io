---
// The persimmon full stop: the only colour and the only moving thing on the page.
// It punctuates whichever line is in view, answers hover, and carries across pages.
---

<span class="full-stop" aria-hidden="true"></span>

<script>
  const dot = document.querySelector<HTMLElement>('.full-stop')!;
  const lines = [...document.querySelectorAll<HTMLElement>('[data-line]')];
  const BASE = 20;
  let active = lines[0];
  let target: HTMLElement | undefined;

  // End of the last glyph, on the baseline, in page coordinates.
  const endOf = (el: HTMLElement) => {
    const text = el.querySelector('.t') ?? el;
    const walker = document.createTreeWalker(text, NodeFilter.SHOW_TEXT);
    let node: Text | null = null;
    for (let n = walker.nextNode(); n; n = walker.nextNode()) if (n.textContent?.trim()) node = n as Text;
    if (!node) return null;
    const range = document.createRange();
    const end = node.textContent!.trimEnd().length;
    range.setStart(node, end - 1);
    range.setEnd(node, end);
    const rects = range.getClientRects();
    const rect = rects[rects.length - 1];
    const size = parseFloat(getComputedStyle(text).fontSize);
    return {
      x: rect.right + window.scrollX + size * 0.05,
      baseline: rect.bottom + window.scrollY - size * 0.265,
      size,
    };
  };

  const place = (el: HTMLElement | undefined) => {
    if (!el) return;
    const end = endOf(el);
    if (!end) return;
    const d = end.size * 0.15;
    dot.style.transform = `translate3d(${end.x}px, ${end.baseline - d}px, 0) scale(${d / BASE})`;
  };

  const settle = () => place(target ?? active);

  dot.classList.add('instant');
  settle();
  requestAnimationFrame(() => dot.classList.remove('instant'));
  document.fonts.ready.then(settle);
  addEventListener('resize', settle);

  // The line nearest the middle of the viewport owns the full stop.
  let queued = false;
  const pick = () => {
    queued = false;
    const mid = innerHeight / 2;
    const nearest = lines.reduce((best, line) => {
      const r = line.getBoundingClientRect();
      const b = best.getBoundingClientRect();
      return Math.abs(r.top + r.height / 2 - mid) < Math.abs(b.top + b.height / 2 - mid) ? line : best;
    });
    if (nearest !== active) {
      active = nearest;
      if (!target) settle();
    }
  };
  addEventListener(
    'scroll',
    () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(pick);
      }
    },
    { passive: true },
  );

  for (const link of document.querySelectorAll<HTMLElement>('[data-line] a, a[data-stop]')) {
    const host = (link.closest('[data-line]') as HTMLElement) ?? link;
    link.addEventListener('pointerenter', () => {
      target = link.hasAttribute('data-stop') ? link : host;
      dot.classList.add('quick');
      settle();
    });
    link.addEventListener('pointerleave', () => {
      target = undefined;
      settle();
      setTimeout(() => dot.classList.remove('quick'), 200);
    });
  }
</script>

<style is:global>
  .full-stop {
    position: absolute;
    top: 0;
    left: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--accent);
    transform-origin: 0 0;
    transition: transform var(--duration-slow) var(--ease-standard);
    view-transition-name: full-stop;
    pointer-events: none;
    will-change: transform;
  }

  .full-stop.quick {
    transition-duration: var(--duration-medium);
  }

  .full-stop.instant {
    transition: none;
  }

  ::view-transition-group(full-stop) {
    animation-duration: var(--duration-slow);
    animation-timing-function: var(--ease-standard);
  }
</style>
