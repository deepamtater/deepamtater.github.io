---
import { url } from '../lib/url';

interface Props {
  what?: string;
}

const { what = 'Nothing' } = Astro.props;
---

<p class="empty">
  {what} published yet. New pieces will appear here and in the <a href={url('/rss.xml')}>RSS feed</a>.
</p>

<style>
  .empty {
    color: var(--muted);
  }

  .empty a {
    color: var(--ink-2);
  }
</style>
