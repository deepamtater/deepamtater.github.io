---
import { url } from '../lib/url';
import { SITE } from '../site.config';

const year = new Date().getFullYear();
const footerSocials = SITE.socials.filter(({ label }) => label !== 'Puvio');
---

<footer class="site-footer wrap">
  <p>© {year} {SITE.author}</p>
  <ul>
    {
      footerSocials.map(({ label, href }) => (
        <li>
          <a href={href} rel="me noopener" target="_blank">
            {label}
          </a>
        </li>
      ))
    }
    <li><a href={url("/rss.xml")}>RSS</a></li>
  </ul>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-m) var(--space-l);
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.01em;
    color: var(--muted);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.15rem;
    padding: 0;
    list-style: none;
  }

  a {
    text-decoration: none;
    color: var(--muted);
    transition: color 140ms ease;
  }

  a:hover {
    color: var(--accent);
  }
</style>
