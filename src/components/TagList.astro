---
import { url } from '../lib/url';

interface Props {
  tags: readonly string[];
  counts?: Record<string, number>;
  filter?: boolean;
  current?: string;
}

const { tags, counts, filter = false, current } = Astro.props;
---

<ul class="tags" role="list">
  {
    tags.map((tag) => (
      <li>
        <a
          href={url(`/tags/${tag}/`)}
          data-filter={filter ? tag : undefined}
          aria-current={current === tag ? 'page' : undefined}
        >
          {tag}
          {counts && <span class="count">{counts[tag] ?? 0}</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.4rem;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
    padding-block: 0.2rem;
    font-size: var(--step--1);
    font-style: italic;
    color: var(--muted);
    text-decoration: none;
    text-transform: capitalize;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 var(--hair) no-repeat;
    transition:
      color 200ms var(--ease),
      background-size 380ms var(--ease-out);
  }

  a:hover {
    color: var(--ink);
    background-size: 100% var(--hair);
  }

  a[aria-current='page'],
  a[aria-pressed='true'] {
    color: var(--accent);
    background-size: 100% var(--hair);
  }

  .count {
    font-style: normal;
    font-size: 0.85em;
    font-variant-numeric: tabular-nums;
  }
</style>
