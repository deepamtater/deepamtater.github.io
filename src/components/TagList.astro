---
import { url } from '../lib/url';
interface Props {
  tags: readonly string[];
  counts?: Record<string, number>;
  filter?: boolean;
  current?: string;
}

const { tags, counts, filter = false, current } = Astro.props;
---

<ul class="tags" role="list">
  {
    tags.map((tag) => (
      <li>
        <a
          href={url(`/tags/${tag}/`)}
          data-filter={filter ? tag : undefined}
          aria-current={current === tag ? 'page' : undefined}
        >
                    {tag}
          {counts && <span class="count">{counts[tag] ?? 0}</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    padding: 0;
    list-style: none;
  }

  a {
    font-size: var(--step--1);
    color: var(--muted);
    text-decoration: none;
    text-transform: capitalize;
  }

  a:hover {
    color: var(--ink);
  }

  a[aria-current='page'],
  a[aria-pressed='true'] {
    color: var(--ink);
    text-decoration: underline;
  }

  .count {
    margin-inline-start: 0.3em;
    font-variant-numeric: tabular-nums;
  }
</style>
