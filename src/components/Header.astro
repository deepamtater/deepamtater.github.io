---
import { url } from '../lib/url';
import { SITE } from '../site.config';

const path = Astro.url.pathname;
const home = url('/');
const isHome = path === home;
const writingHref = url('/writing/');
const essaysHref = url('/essays/');
const notesHref = url('/notes/');
const nav = SITE.nav.map(({ href, label }) => ({ href: url(href), label }));
const isCurrent = (href: string) =>
  path.startsWith(href) ||
  (href === writingHref && (path.startsWith(essaysHref) || path.startsWith(notesHref)));
const hasCurrent = nav.some(({ href }) => isCurrent(href));
---

<header class="site-header wrap">
  <a
    class="wordmark"
    href={home}
    aria-label={`${SITE.name}, home`}
    aria-current={isHome ? 'page' : undefined}
    data-dot-target
    data-dot-rest={isHome || !hasCurrent ? '' : undefined}
  >
    <span class="label">{SITE.name}</span><span class="stop" aria-hidden="true">.</span>
  </a>
  <nav aria-label="Primary">
    <ul>
      {
        nav.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={isCurrent(href) ? 'page' : undefined}
              data-dot-target
              data-dot-rest={isCurrent(href) ? '' : undefined}
            >
              <span class="label">{label}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="controls">
      <button
        class="search-trigger"
        type="button"
        aria-label="Search site"
        aria-keyshortcuts="/ Control+K Meta+K"
        title="Search (/)"
        data-search-open
        data-dot-target
      >
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"
          ></circle>
          <path d="M15.5 15.5L20 20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
          ></path>
        </svg>
        <kbd class="label mono" aria-hidden="true">/</kbd>
      </button>
      <button
        class="theme-toggle"
        type="button"
        aria-label="Toggle color theme"
        title="Toggle theme"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.5"
          ></circle>
          <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script is:inline>
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>

<style>
  .site-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: clamp(1.25rem, 1rem + 1.5vw, 2.25rem) 0;
    view-transition-name: site-header;
  }

  .wordmark {
    font-size: var(--step-1);
    font-style: italic;
    font-weight: 450;
    letter-spacing: -0.015em;
    text-decoration: none;
    white-space: nowrap;
    color: var(--ink);
  }

  .wordmark .label {
    display: inline-block;
    transition:
      color 180ms var(--ease),
      transform 220ms var(--ease);
  }

  .wordmark:hover,
  .wordmark:focus-visible {
    color: var(--ink);
  }

  /* Unified response across the entire name on hover or focus */
  .wordmark:hover .label,
  .wordmark:focus-visible .label {
    color: var(--accent);
    transform: translateY(-0.5px);
  }

  .stop {
    color: var(--accent);
    font-style: normal;
  }

  :global(.has-dot) .stop {
    color: transparent;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(0.45rem, 1.5vw, 1rem);
  }

  ul {
    display: flex;
    gap: clamp(0.85rem, 2.4vw, 1.45rem);
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.01em;
    text-decoration: none;
    color: var(--muted);
    padding-block: 0.25rem;
    padding-inline-end: 0.25em;
    transition: color 140ms ease;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    height: 2rem;
    padding: 0 0.45rem;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition:
      color 140ms ease,
      border-color 140ms ease,
      background-color 140ms ease;
  }

  .search-trigger:hover,
  .search-trigger:focus-visible {
    color: var(--ink);
    border-color: color-mix(in oklab, var(--ink) 26%, var(--rule));
    background: var(--hover);
  }

  .search-trigger kbd {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1;
    color: inherit;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-inline-end: -0.4rem;
    border: 0;
    border-radius: 4px;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition:
      color 140ms ease,
      background-color 140ms ease;
  }

  @media (pointer: coarse) {
    .theme-toggle,
    .search-trigger {
      min-height: 2.5rem;
    }

    nav a {
      padding-block: 0.45rem;
    }
  }

  .theme-toggle:hover {
    color: var(--ink);
    background: var(--hover);
  }

  @media (max-width: 36rem) {
    .site-header {
      flex-wrap: wrap;
      row-gap: 0.35rem;
    }

    nav {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
