---
import { url } from '../lib/url';
import { SITE } from '../site.config';

const path = Astro.url.pathname;
const home = url('/');
const isHome = path === home;
const nav = SITE.nav.map(({ href, label }) => ({ href: url(href), label }));
const isCurrent = (href: string) => path.startsWith(href);
const hasCurrent = nav.some(({ href }) => isCurrent(href));
---

<header class="site-header wrap">
  <a
    class="wordmark"
    href={home}
    aria-label={`${SITE.name}, home`}
    aria-current={isHome ? 'page' : undefined}
    data-dot-target
    data-dot-rest={isHome || !hasCurrent ? '' : undefined}
  >
    <span class="label">{SITE.name}</span><span class="stop" aria-hidden="true">.</span>
  </a>
  <nav aria-label="Primary">
    <ul>
      {
        nav.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={isCurrent(href) ? 'page' : undefined}
              data-dot-target
              data-dot-rest={isCurrent(href) ? '' : undefined}
            >
              <span class="label">{label}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <button class="theme-toggle" type="button" aria-label="Dark theme" aria-pressed="false" title="Light or dark">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor"></path>
      </svg>
    </button>
  </nav>
</header>

<script is:inline>
  (() => {
    const toggle = document.querySelector('.theme-toggle');
    const root = document.documentElement;
    const sync = () => toggle?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
    sync();
    toggle?.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      const apply = () => {
        root.dataset.theme = next;
        localStorage.setItem('theme', next);
        sync();
      };
      if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.startViewTransition(apply);
      } else {
        apply();
      }
    });
  })();
</script>

<style>
  .site-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.7rem) 0;
    view-transition-name: site-header;
  }

  .wordmark {
    font-size: var(--step-0);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark:hover {
    color: var(--ink);
  }

  /* The plain-text full stop; the moving dot takes its place once scripts run. */
  .stop {
    color: var(--ink);
  }

  :global(.has-dot) .stop {
    color: transparent;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(0.25rem, 1.5vw, 1rem);
  }

  ul {
    display: flex;
    gap: clamp(0.9rem, 2.5vw, 1.5rem);
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-block;
    padding-block: 0.3rem;
    padding-inline-end: 0.35em;
    font-size: var(--step-0);
    font-weight: 500;
    text-decoration: none;
    color: var(--muted);
    transition: color var(--duration-fast) var(--ease);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    align-self: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-inline-end: -0.5rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease);
  }

  .theme-toggle:hover {
    color: var(--ink);
  }

  .theme-toggle svg {
    transition: transform var(--duration-medium) var(--ease);
  }

  :global([data-theme='dark']) .theme-toggle svg {
    transform: rotate(180deg);
  }

  @media (max-width: 34rem) {
    .site-header {
      flex-wrap: wrap;
      row-gap: 0.6rem;
    }

    nav {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
