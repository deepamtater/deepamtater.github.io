---
import { url } from '../lib/url';
import { SITE } from '../site.config';

const path = Astro.url.pathname;
const nav = SITE.nav.map(({ href, label }) => ({ href: url(href), label }));
const isCurrent = (href: string) => path.startsWith(href);
---

<header class="site-header wrap">
  <a class="wordmark" href={url("/")} aria-label={`${SITE.name}, home`}>
    {SITE.name}<span class="dot" aria-hidden="true">.</span>
  </a>
  <nav aria-label="Primary">
    <ul>
      {
        nav.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    <button class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle theme">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor"></path>
      </svg>
    </button>
  </nav>
</header>

<script is:inline>
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    const apply = () => {
      root.dataset.theme = next;
      localStorage.setItem('theme', next);
    };
    if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.startViewTransition(apply);
    } else {
      apply();
    }
  });
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: clamp(1.25rem, 1rem + 1.5vw, 2.25rem) 0;
    view-transition-name: site-header;
  }

  .wordmark {
    font-size: var(--step-1);
    font-style: italic;
    font-weight: 450;
    letter-spacing: -0.015em;
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark:hover {
    color: var(--ink);
  }

  .dot {
    display: inline-block;
    color: var(--accent);
    font-style: normal;
    transition: transform 420ms var(--ease);
  }

  .wordmark:hover .dot {
    transform: translateY(-0.18em) scale(1.25);
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(0.25rem, 1.5vw, 1rem);
  }

  ul {
    display: flex;
    gap: clamp(0.85rem, 2.5vw, 1.6rem);
    padding: 0;
    list-style: none;
  }

  nav a {
    position: relative;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
  }

  nav a::after {
    content: '';
    position: absolute;
    inset: auto 0 -0.4em;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 280ms var(--ease);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  nav a:hover::after,
  nav a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-inline-end: -0.5rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition:
      color 160ms var(--ease),
      background 160ms var(--ease);
  }

  .theme-toggle:hover {
    color: var(--ink);
    background: var(--paper-2);
  }

  .theme-toggle svg {
    transition: transform 500ms var(--ease);
  }

  :global([data-theme='dark']) .theme-toggle svg {
    transform: rotate(180deg);
  }

  @media (max-width: 34rem) {
    .site-header {
      flex-wrap: wrap;
      row-gap: 0.4rem;
    }

    nav {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
