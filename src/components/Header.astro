---
import { url } from '../lib/url';
import { SITE } from '../site.config';

const path = Astro.url.pathname;
const nav = SITE.nav.map(({ href, label }) => ({ href: url(href), label }));
const isCurrent = (href: string) => path.startsWith(href);
---

<header class="site-header wrap">
  <a class="wordmark" href={url("/")} aria-label={`${SITE.name}, home`}>
    {SITE.name}<span class="dot" aria-hidden="true">.</span>
  </a>
  <nav aria-label="Primary">
    <ul>
      {
        nav.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    <button class="theme-toggle" type="button" aria-label="Toggle color theme" title="Toggle theme">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"></path>
      </svg>
    </button>
  </nav>
</header>

<script is:inline>
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: clamp(1.25rem, 1rem + 1.5vw, 2.25rem) 0;
  }

  .wordmark {
    font-size: var(--step-1);
    font-style: italic;
    font-weight: 450;
    letter-spacing: -0.015em;
    text-decoration: none;
    white-space: nowrap;
    color: var(--ink);
  }

  .wordmark:hover {
    color: var(--ink);
  }

  .dot {
    color: var(--accent);
    font-style: normal;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(0.4rem, 1.5vw, 1rem);
  }

  ul {
    display: flex;
    gap: clamp(0.85rem, 2.5vw, 1.5rem);
    padding: 0;
    list-style: none;
  }

  nav a {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.01em;
    text-decoration: none;
    color: var(--muted);
    padding-block: 0.25rem;
    transition: color 140ms ease;
  }

  nav a:hover {
    color: var(--accent);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration-line: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.32em;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-inline-end: -0.5rem;
    border: 0;
    border-radius: 4px;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition:
      color 140ms ease,
      background-color 140ms ease;
  }

  @media (pointer: coarse) {
    .theme-toggle {
      min-width: 2.75rem;
      min-height: 2.75rem;
    }

    nav a {
      padding-block: 0.5rem;
    }
  }

  .theme-toggle:hover {
    color: var(--ink);
    background: var(--hover);
  }

  @media (max-width: 34rem) {
    .site-header {
      flex-wrap: wrap;
      row-gap: 0.4rem;
    }

    nav {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
