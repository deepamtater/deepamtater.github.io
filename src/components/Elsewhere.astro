---
import { url } from '../lib/url';
import { SITE } from '../site.config';
import CopyEmail from './CopyEmail.astro';

interface Props {
  /** One line of links (home) or a short list with handles (about). */
  variant?: 'line' | 'list';
}

const { variant = 'line' } = Astro.props;
---

{
  variant === 'line' ? (
    <p class="elsewhere-line">
      <span class="muted">Elsewhere</span>
      {SITE.socials.map(({ label, href }) => (
        <a href={href} rel="me noopener">
          {label}
        </a>
      ))}
      <span class="email">
        <a href={`mailto:${SITE.email}`}>Email</a> <CopyEmail />
      </span>
    </p>
  ) : (
    <dl class="elsewhere-list">
      {SITE.socials.map(({ label, handle, href }) => (
        <div>
          <dt>{label}</dt>
          <dd>
            <a href={href} rel="me noopener">
              {handle}
            </a>
          </dd>
        </div>
      ))}
      <div>
        <dt>Email</dt>
        <dd>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a> <CopyEmail />
        </dd>
      </div>
      <div>
        <dt>RSS</dt>
        <dd>
          <a href={url('/rss.xml')}>Feed</a>
        </dd>
      </div>
    </dl>
  )
}

<style>
  .elsewhere-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.85rem;
    font-size: var(--step-0);
    font-weight: 500;
  }

  .email {
    white-space: nowrap;
  }

  .email :global(.copy-email) {
    margin-inline-start: 0.35rem;
  }

  .elsewhere-line a {
    color: var(--ink);
    text-decoration: none;
  }

  .elsewhere-line a:hover {
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
  }

  .elsewhere-list {
    display: grid;
    gap: 0.35rem;
  }

  .elsewhere-list div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-s);
  }

  dt {
    color: var(--muted);
  }

  dd {
    overflow-wrap: break-word;
  }

  dd :global(.copy-email) {
    margin-inline-start: 0.6rem;
  }
</style>
