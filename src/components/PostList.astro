---
import { formatDate, formatShortDate, kindLabel, postUrl, transitionName, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  showKind?: boolean;
  showSummary?: boolean;
  shortDate?: boolean;
}

const { posts, showKind = false, showSummary = false, shortDate = false } = Astro.props;
---

<ol class="post-list" role="list">
  {
    posts.map((post) => (
      <li data-tags={post.data.tags.join(' ')}>
        <a href={postUrl(post)}>
          <span class="meta">
            <time datetime={post.data.date.toISOString()}>
              {shortDate ? formatShortDate(post.data.date) : formatDate(post.data.date)}
            </time>
            {showKind && <span>{kindLabel(post)}</span>}
          </span>
          <span class="title" style={`view-transition-name: ${transitionName(post)}`}>
            {post.data.title}
            {post.data.draft && <span class="draft">draft</span>}
          </span>
          {showSummary && <span class="summary">{post.data.summary}</span>}
        </a>
      </li>
    ))
  }
</ol>

<style>
  .post-list {
    padding: 0;
    list-style: none;
  }

  li + li {
    border-top: var(--hair) solid var(--rule);
  }

  li:nth-child(1 of :not([hidden])) {
    border-top: 0;
  }

  a {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    grid-template-areas:
      'meta title'
      'meta summary';
    column-gap: var(--space-m);
    padding-block: 1rem 1.1rem;
    text-decoration: none;
  }

  .meta {
    grid-area: meta;
    display: grid;
    align-content: start;
    padding-block-start: 0.35rem;
    font-size: var(--step--1);
    font-style: italic;
    line-height: 1.4;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .title {
    grid-area: title;
    width: fit-content;
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.2;
    color: var(--ink);
    text-wrap: balance;
    background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0 var(--hair) no-repeat;
    transition:
      background-size 420ms var(--ease-out),
      color 200ms var(--ease);
  }

  a:hover .title,
  a:focus-visible .title {
    color: var(--accent);
    background-size: 100% var(--hair);
  }

  .summary {
    grid-area: summary;
    margin-block-start: 0.35rem;
    max-width: 58ch;
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--muted);
  }

  .draft {
    margin-inline-start: 0.5rem;
    font-family: var(--font-text);
    font-size: var(--step--1);
    font-style: italic;
    color: var(--accent);
  }

  @media (max-width: 34rem) {
    a {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'meta'
        'title'
        'summary';
    }

    .meta {
      display: flex;
      gap: 0.75rem;
      padding-block: 0 0.25rem;
    }
  }
</style>
