---
import {
  formatDate,
  formatShortDate,
  kindLabel,
  postUrl,
  transitionName,
  type Post,
} from '../lib/posts';

interface Props {
  posts: Post[];
  showKind?: boolean;
  showSummary?: boolean;
  shortDate?: boolean;
}

const { posts, showKind = false, showSummary = false, shortDate = false } = Astro.props;
---

<ol class="post-list" role="list">
  {
    posts.map((post) => (
      <li data-tags={post.data.tags.join(' ')}>
        <a href={postUrl(post)}>
          <span class="title" style={`view-transition-name: ${transitionName(post)}`}>
            {post.data.title}
            {post.data.draft && <span class="draft">draft</span>}
          </span>
          {showSummary && <span class="summary">{post.data.summary}</span>}
          <span class="meta">
            {showKind && <span class="kind">{kindLabel(post)}</span>}
            <time datetime={post.data.date.toISOString()}>
              {shortDate ? formatShortDate(post.data.date) : formatDate(post.data.date)}
            </time>
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .post-list {
    display: grid;
    gap: 1.6rem;
    padding: 0;
    list-style: none;
  }

  a {
    display: grid;
    gap: 0.2rem;
    text-decoration: none;
  }

  .title {
    width: fit-content;
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.35;
    color: var(--ink);
    text-wrap: balance;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--duration-fast) var(--ease);
  }

  a:hover .title,
  a:focus-visible .title {
    text-decoration-color: currentColor;
  }

  .summary {
    max-width: 60ch;
    color: var(--muted);
  }

  .meta {
    display: flex;
    gap: 0.75rem;
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .draft {
    margin-inline-start: 0.5rem;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--muted);
  }
</style>
