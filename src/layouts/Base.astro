---
import { url } from '../lib/url';
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import SignatureDot from '../components/SignatureDot.astro';
import { SITE } from '../site.config';

export interface CollectionListItem {
  name: string;
  url: string;
  description?: string;
  datePublished?: string;
}

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  pageType?: 'WebPage' | 'ProfilePage' | 'CollectionPage';
  publishedTime?: Date;
  tags?: readonly string[];
  progress?: boolean;
  collectionItems?: CollectionListItem[];
  extraSchemaNodes?: Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  type = 'website',
  pageType = 'WebPage',
  publishedTime,
  tags = [],
  collectionItems,
  extraSchemaNodes = [],
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const siteOrigin = (Astro.site ?? new URL('https://deepamtater.github.io')).origin;
const canonical = new URL(Astro.url.pathname, siteOrigin);
const ogImage = new URL(url(SITE.ogImage), siteOrigin);
const rss = new URL(url('/rss.xml'), siteOrigin);

const personId = `${siteOrigin}/#person`;
const websiteId = `${siteOrigin}/#website`;
const webpageId = `${canonical.href}#webpage`;

const personNode = {
  '@type': 'Person',
  '@id': personId,
  name: 'Deepam Tater',
  alternateName: 'Dee Tater',
  jobTitle: 'Founder',
  description: SITE.description,
  url: `${siteOrigin}/`,
  worksFor: {
    '@type': 'Organization',
    name: 'Puvio',
    url: 'https://puvio.app',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Government Engineering College Jaipur',
  },
  knowsAbout: [
    'Large Language Models',
    'AI Engineering',
    'Startups',
    'Answer Engine Optimization',
    'Software Engineering',
  ],
  sameAs: [
    'https://puvio.app',
    'https://x.com/justdeepam',
    'https://www.linkedin.com/in/deepamtater/',
    'https://github.com/dimension-drifter',
    'https://huggingface.co/dimension-drifter',
  ],
};

const websiteNode = {
  '@type': 'WebSite',
  '@id': websiteId,
  url: `${siteOrigin}/`,
  name: SITE.title,
  description: SITE.description,
  inLanguage: SITE.locale,
  author: { '@id': personId },
  publisher: { '@id': personId },
};

const segments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbNode =
  segments.length > 0
    ? {
        '@type': 'BreadcrumbList',
        '@id': `${canonical.href}#breadcrumb`,
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: SITE.name,
            item: `${siteOrigin}/`,
          },
          ...segments.map((seg, i) => {
            const pathHref = `${siteOrigin}/${segments.slice(0, i + 1).join('/')}/`;
            const isLast = i === segments.length - 1;
            const label =
              isLast && title
                ? title
                : seg === '2am'
                  ? '2AM'
                  : seg.charAt(0).toUpperCase() + seg.slice(1);
            return {
              '@type': 'ListItem',
              position: i + 2,
              name: label,
              item: pathHref,
            };
          }),
        ],
      }
    : null;

const itemListNode =
  collectionItems && collectionItems.length > 0
    ? {
        '@type': 'ItemList',
        '@id': `${canonical.href}#itemlist`,
        numberOfItems: collectionItems.length,
        itemListElement: collectionItems.map((item, idx) => ({
          '@type': 'ListItem',
          position: idx + 1,
          name: item.name,
          url: new URL(item.url, siteOrigin).href,
          ...(item.description ? { description: item.description } : {}),
          ...(item.datePublished ? { datePublished: item.datePublished } : {}),
        })),
      }
    : null;

const webPageNode: Record<string, unknown> = {
  '@type': pageType,
  '@id': webpageId,
  url: canonical.href,
  name: pageTitle,
  description,
  isPartOf: { '@id': websiteId },
  about: { '@id': personId },
  inLanguage: SITE.locale,
  ...(pageType === 'ProfilePage' ? { mainEntity: { '@id': personId } } : {}),
  ...(itemListNode ? { mainEntity: { '@id': `${canonical.href}#itemlist` } } : {}),
  ...(breadcrumbNode ? { breadcrumb: { '@id': `${canonical.href}#breadcrumb` } } : {}),
};

const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    personNode,
    websiteNode,
    webPageNode,
    ...(breadcrumbNode ? [breadcrumbNode] : []),
    ...(itemListNode ? [itemListNode] : []),
    ...extraSchemaNodes,
  ],
};
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Deepam Tater" />
    <meta name="google-site-verification" content="oHrWp1gfUx__cpUuBdra3PhIFBQmMYC_gq1sMyxp1UA" />
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={rss} />
    <link rel="sitemap" href={url("/sitemap-index.xml")} />
    {SITE.socials.map(({ href }) => <link rel="me" href={href} />)}
    <meta name="theme-color" content="#F8F7F4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#20221F" media="(prefers-color-scheme: dark)" />

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {type === 'article' && <meta property="article:author" content="Deepam Tater" />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />

    <Font cssVariable="--font-serif" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-mono" />

    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="2887805c-0b76-42e9-a3ee-78be17d79ed9"
      data-domains="deepamtater.github.io"></script>

    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <SearchModal />
    <SignatureDot />
  </body>
</html>
