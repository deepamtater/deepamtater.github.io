---
import { url } from '../lib/url';
import { render } from 'astro:content';
import Base from './Base.astro';
import TagList from '../components/TagList.astro';
import PostList from '../components/PostList.astro';
import {
  formatDate,
  getPosts,
  kindLabel,
  postUrl,
  readingTime,
  relatedPosts,
  transitionName,
  type Post,
} from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const isEssay = post.collection === 'essays';

const siblings = await getPosts(post.collection);
const index = siblings.findIndex((p) => p.id === post.id);
const newer = siblings[index - 1];
const older = siblings[index + 1];
const adjacent = new Set([newer, older].filter(Boolean).map((p) => postUrl(p!)));
const related = relatedPosts(
  post,
  (await getPosts()).filter((p) => !adjacent.has(postUrl(p))),
);
---

<Base
  title={post.data.title}
  description={post.data.summary}
  type="article"
  publishedTime={post.data.date}
  tags={post.data.tags}
>
  <article class="wrap">
    <header class="leaf post-head">
      <div class="margin rise" style="--d: 1">
        <a href={url(`/${post.collection}/`)}>{kindLabel(post)}</a>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>{readingTime(post.body)}</span>
      </div>
      <div class="body">
        <h1 style={`view-transition-name: ${transitionName(post)}`}>{post.data.title}</h1>
        {isEssay && <p class="dek rise" style="--d: 2">{post.data.summary}</p>}
      </div>
    </header>

    <div class="leaf">
      <div class="margin" />
      <div class="body prose rise" style="--d: 3">
        <Content />
      </div>
    </div>

    <footer class="leaf post-foot">
      <p class="margin">Filed under</p>
      <div class="body">
        {post.data.tags.length > 0 && <TagList tags={post.data.tags} />}

        {
          (newer || older) && (
            <nav class="pager" aria-label={`More ${post.collection}`}>
              {older ? (
                <a href={postUrl(older)} rel="prev">
                  <span class="dir">Previous</span>
                  <span class="pager-title">{older.data.title}</span>
                </a>
              ) : (
                <span />
              )}
              {newer && (
                <a href={postUrl(newer)} rel="next" class="next">
                  <span class="dir">Next</span>
                  <span class="pager-title">{newer.data.title}</span>
                </a>
              )}
            </nav>
          )
        }

        {
          related.length > 0 && (
            <section class="related" aria-labelledby="related-heading">
              <h2 id="related-heading" class="section-title">
                Related
              </h2>
              <PostList posts={related} showKind />
            </section>
          )
        }
      </div>
    </footer>
  </article>
</Base>

<style>
  .post-head {
    padding-block: var(--space-m) var(--space-l);
  }

  .post-head .margin {
    display: grid;
    align-content: start;
    gap: 0.15rem;
    font-variant-numeric: tabular-nums;
  }

  .post-head .margin a {
    color: var(--accent);
    text-decoration: none;
  }

  h1 {
    max-width: 18ch;
    font-size: var(--step-4);
    line-height: 1;
    letter-spacing: -0.015em;
  }

  .dek {
    margin-block-start: var(--space-s);
    max-width: 40ch;
    font-size: var(--step-1);
    font-style: italic;
    line-height: 1.4;
    color: var(--muted);
  }

  .post-foot {
    margin-block-start: var(--space-xl);
  }

  .post-foot .body {
    display: grid;
    gap: var(--space-l);
    max-width: var(--measure);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-s);
    padding-block-start: var(--space-m);
    border-top: var(--hair) solid var(--rule);
  }

  .pager a {
    display: grid;
    gap: 0.3rem;
    text-decoration: none;
  }

  .dir {
    font-size: var(--step--1);
    font-style: italic;
    color: var(--muted);
  }

  .pager .next {
    text-align: end;
  }

  .pager-title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.2;
    transition: color 200ms var(--ease);
  }

  .pager a:hover .pager-title {
    color: var(--accent);
  }

  @media (max-width: 34rem) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager .next {
      text-align: start;
    }
  }
</style>
