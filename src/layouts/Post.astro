---
import { url } from '../lib/url';
import { render } from 'astro:content';
import Base from './Base.astro';
import TagList from '../components/TagList.astro';
import PostList from '../components/PostList.astro';
import {
  formatDate,
  getPosts,
  kindLabel,
  postUrl,
  readingTime,
  relatedPosts,
  transitionName,
  type Post,
} from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const isEssay = post.collection === 'essays';

const siblings = await getPosts(post.collection);
const index = siblings.findIndex((p) => p.id === post.id);
const newer = siblings[index - 1];
const older = siblings[index + 1];
const adjacent = new Set([newer, older].filter(Boolean).map((p) => postUrl(p!)));
const related = relatedPosts(
  post,
  (await getPosts()).filter((p) => !adjacent.has(postUrl(p))),
);
---

<Base
  title={post.data.title}
  description={post.data.summary}
  type="article"
  publishedTime={post.data.date}
  tags={post.data.tags}
>
  <article class="wrap">
    <header class="post-head">
      <h1 style={`view-transition-name: ${transitionName(post)}`}>{post.data.title}</h1>
      {isEssay && <p class="dek">{post.data.summary}</p>}
      <p class="byline">
        <a href={url(`/${post.collection}/`)}>{kindLabel(post)}</a>
        <span aria-hidden="true">·</span>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body)}</span>
      </p>
    </header>

    <div class:list={['prose', { 'prose--essay': isEssay }]} data-article>
      <Content />
    </div>

    <footer class="post-foot">
      {post.data.tags.length > 0 && <TagList tags={post.data.tags} />}

      {
        (newer || older) && (
          <nav class="pager" aria-label={`More ${post.collection}`}>
            {older ? (
              <a href={postUrl(older)} rel="prev">
                <span class="dir">Previous</span>
                <span class="pager-title">{older.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {newer && (
              <a href={postUrl(newer)} rel="next" class="next">
                <span class="dir">Next</span>
                <span class="pager-title">{newer.data.title}</span>
              </a>
            )}
          </nav>
        )
      }

      {
        related.length > 0 && (
          <section class="related" aria-labelledby="related-heading">
            <h2 id="related-heading" class="section-title">
              Related
            </h2>
            <PostList posts={related} showKind />
          </section>
        )
      }
    </footer>
  </article>
</Base>

<style>
  .post-head {
    max-width: var(--measure);
    margin-block: var(--space-m) var(--space-l);
  }

  h1 {
    font-size: var(--step-3);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .dek {
    margin-block-start: 0.75rem;
    font-size: var(--step-lede);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    margin-block-start: 1rem;
    font-size: var(--step--1);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .byline a {
    color: var(--muted);
    text-decoration: none;
  }

  .byline a:hover {
    color: var(--ink);
  }

  .post-foot {
    max-width: var(--measure);
    margin-block-start: var(--space-xl);
    display: grid;
    gap: var(--space-l);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-s);
    padding-block-start: var(--space-m);
    border-top: 1px solid var(--rule);
  }

  .pager a {
    display: grid;
    gap: 0.2rem;
    text-decoration: none;
  }

  .dir {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .pager .next {
    text-align: end;
  }

  .pager-title {
    font-weight: 700;
    line-height: 1.35;
  }

  .pager a:hover .pager-title {
    text-decoration: underline;
  }

  .related h2 {
    margin-block-end: 0.75rem;
  }

  @media (max-width: 34rem) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager .next {
      text-align: start;
    }
  }
</style>
