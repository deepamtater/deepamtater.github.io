---
import { url } from '../lib/url';
import { render } from 'astro:content';
import Base from './Base.astro';
import TagList from '../components/TagList.astro';
import PostList from '../components/PostList.astro';
import {
  countWords,
  formatDate,
  getPosts,
  kindLabel,
  postUrl,
  readingMinutes,
  readingTime,
  relatedPosts,
  type Post,
} from '../lib/posts';
import { SITE } from '../site.config';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const isEssay = post.collection === 'essays';

const siblings = await getPosts(post.collection);
const index = siblings.findIndex((p) => p.id === post.id);
const newer = siblings[index - 1];
const older = siblings[index + 1];
const adjacent = new Set([newer, older].filter(Boolean).map((p) => postUrl(p!)));
const related = relatedPosts(
  post,
  (await getPosts()).filter((p) => !adjacent.has(postUrl(p))),
);

const siteOrigin = (Astro.site ?? new URL('https://deepamtater.github.io')).origin;
const canonicalUrl = new URL(postUrl(post), siteOrigin).href;
const words = countWords(post.body);
const minutes = readingMinutes(post.body);

const blogPostingNode = {
  '@type': 'BlogPosting',
  '@id': `${canonicalUrl}#article`,
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.date.toISOString(),
  wordCount: words,
  timeRequired: `PT${minutes}M`,
  keywords: post.data.tags,
  articleSection: kindLabel(post),
  inLanguage: SITE.locale,
  url: canonicalUrl,
  isPartOf: { '@id': `${siteOrigin}/#website` },
  author: { '@id': `${siteOrigin}/#person` },
  publisher: { '@id': `${siteOrigin}/#person` },
  mainEntityOfPage: { '@id': `${canonicalUrl}#webpage` },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['article h1', '.post-summary', '.prose p:first-of-type'],
  },
};
---

<Base
  title={post.data.title}
  description={post.data.summary}
  type="article"
  publishedTime={post.data.date}
  tags={post.data.tags}
  progress
  extraSchemaNodes={[blogPostingNode]}
>
  <article class="wrap">
    <header class="post-head">
      <h1>{post.data.title}</h1>
      {isEssay && <p class="dek post-summary">{post.data.summary}</p>}
      <p class="post-meta">
        <a href={url(`/${post.collection}/`)}>{kindLabel(post)}</a>
        <span aria-hidden="true">·</span>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body)}</span>
      </p>
    </header>

    <div class:list={['prose', { 'prose--essay': isEssay }]} data-article>
      <Content />
    </div>

    <footer class="post-foot">
      {post.data.tags.length > 0 && <TagList tags={post.data.tags} />}

      {
        (newer || older) && (
          <nav class="pager" aria-label={`More ${post.collection}`}>
            {older ? (
              <a href={postUrl(older)} rel="prev">
                <span class="pager-label">Previous</span>
                <span class="pager-title">{older.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {newer && (
              <a href={postUrl(newer)} rel="next" class="next">
                <span class="pager-label">Next</span>
                <span class="pager-title">{newer.data.title}</span>
              </a>
            )}
          </nav>
        )
      }

      {
        related.length > 0 && (
          <section class="related" aria-labelledby="related-heading">
            <h2 id="related-heading" class="eyebrow">
              Related
            </h2>
            <PostList posts={related} showKind />
          </section>
        )
      }
    </footer>
  </article>
</Base>

<style>
  .post-head {
    max-width: var(--measure);
    margin-block: var(--space-m) var(--space-l);
    padding-block-end: var(--space-m);
    border-bottom: 1px solid var(--rule);
  }

  h1 {
    font-size: var(--step-4);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .dek {
    margin-block-start: 0.9rem;
    font-size: var(--step-1);
    font-style: italic;
    line-height: 1.42;
    color: var(--muted);
  }

  .post-meta {
    margin-block-start: 0.95rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55em;
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .post-meta a {
    color: var(--accent);
    text-decoration: none;
  }

  .post-meta a:hover {
    text-decoration: underline;
  }

  .post-foot {
    max-width: var(--measure);
    margin-block-start: var(--space-xl);
    display: grid;
    gap: var(--space-l);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-s);
    padding-block-start: var(--space-m);
    border-top: 1px solid var(--rule);
  }

  .pager a {
    display: grid;
    gap: 0.3rem;
    padding: 0.75rem 0.85rem;
    margin-inline: -0.85rem;
    border-radius: 4px;
    text-decoration: none;
    transition: background-color 140ms ease;
  }

  .pager a:hover {
    background: var(--hover);
    color: var(--ink);
  }

  .pager-label {
    font-size: var(--step--1);
    font-style: italic;
    color: var(--muted);
  }

  .pager a:hover .pager-title {
    color: var(--accent);
  }

  .pager .next {
    text-align: end;
  }

  .pager-title {
    line-height: 1.32;
    transition: color 140ms ease;
  }

  .related h2 {
    margin-block-end: 0.25rem;
  }

  @media (max-width: 34rem) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager .next {
      text-align: start;
    }
  }
</style>
