---
import { url } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/posts';
import { TOPICS } from '../../site.config';

const posts = await getPosts();
const topics = TOPICS.map((tag) => ({
  tag,
  count: posts.filter((p) => p.data.tags.includes(tag)).length,
}));
---

<Base title="Topics" description="Browse writing by topic.">
  <div class="wrap">
    <header class="page-head">
      <h1>Topics</h1>
      <p>Four subjects I keep returning to.</p>
    </header>
    <ul class="topics" role="list">
      {
        topics.map(({ tag, count }) => (
          <li>
            <a href={url(`/tags/${tag}/`)}>
              <span class="name">{tag}</span>
              <span class="mono">
                {count} {count === 1 ? 'piece' : 'pieces'}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .topics {
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  li {
    border-bottom: 1px solid var(--rule);
  }

  a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1rem 0.65rem;
    margin-inline: -0.65rem;
    border-radius: 4px;
    text-decoration: none;
    transition:
      background-color 140ms ease,
      color 140ms ease;
  }

  a:hover {
    background: var(--hover);
  }

  .name {
    font-size: var(--step-1);
    font-style: italic;
    text-transform: capitalize;
    color: var(--ink);
    transition: color 140ms ease;
  }

  a:hover .name {
    color: var(--accent);
  }

  .mono {
    color: var(--muted);
  }
</style>
