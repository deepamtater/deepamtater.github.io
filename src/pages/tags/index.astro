---
import { url } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import { TOPICS } from '../../site.config';
---

<Base
  title="Topics"
  documentTitle="Topics Deepam Tater writes about, from startups to books."
  description="Browse writing by topic."
>
  <div class="wrap">
    <header class="page-head">
      <h1>Topics</h1>
    </header>
    <ul class="topics" role="list">
      {
        TOPICS.map((tag) => (
          <li>
            <a href={url(`/topics/${tag}/`)}>
              <span class="name">{tag}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .topics {
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  li {
    border-bottom: 1px solid var(--rule);
  }

  a {
    display: block;
    padding: 1rem 0.65rem;
    margin-inline: -0.65rem;
    border-radius: 4px;
    text-decoration: none;
    transition:
      background-color 140ms ease,
      color 140ms ease;
  }

  a:hover {
    background: var(--hover);
  }

  .name {
    font-size: var(--step-1);
    font-style: italic;
    text-transform: capitalize;
    color: var(--ink);
    transition: color 140ms ease;
  }

  a:hover .name {
    color: var(--accent);
  }
</style>
