---
import { url } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import PageTitle from '../../components/PageTitle.astro';
import { entryCount, getPosts } from '../../lib/posts';
import { lockeKey } from '../../lib/locke';
import { TOPICS } from '../../site.config';

const posts = await getPosts();
const heads = TOPICS.map((tag) => {
  const { letter, vowel } = lockeKey(tag);
  return { tag, key: `${letter}${vowel}`, count: posts.filter((p) => p.data.tags.includes(tag)).length };
});
---

<Base title="Heads" description="The four subjects Dee Tater's essays and notes are filed under.">
  <div class="wrap">
    <PageTitle title="Heads" dek="Four subjects this book keeps returning to." note={`${heads.length} heads`} />
    <ul class="heads" role="list">
      {
        heads.map(({ tag, key, count }) => (
          <li class="leaf">
            <span class="margin">
              <span class="visually-hidden">Index key </span>
              {key}
            </span>
            <a class="body" href={url(`/tags/${tag}/`)}>
              <span class="name">{tag}</span>
              <span class="count">{entryCount(count)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .heads {
    padding: 0;
    list-style: none;
  }

  .margin {
    align-self: center;
    font-style: normal;
    font-family: var(--font-display);
  }

  a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-s);
    padding-block: 1rem;
    border-bottom: var(--hair) solid var(--rule);
    text-decoration: none;
  }

  li:first-child a {
    border-top: var(--hair) solid var(--rule);
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1;
    text-transform: capitalize;
    transition: transform 500ms var(--ease-out);
  }

  a:hover .name {
    transform: translateX(0.35rem);
  }

  .count {
    font-size: var(--step--1);
    font-style: italic;
    color: var(--muted);
  }
</style>
