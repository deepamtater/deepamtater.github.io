---
import { url } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/posts';
import { TOPICS } from '../../site.config';

const posts = await getPosts();
const topics = TOPICS.map((tag) => ({
  tag,
  count: posts.filter((p) => p.data.tags.includes(tag)).length,
}));
---

<Base title="Topics" description="Browse writing by topic.">
  <div class="wrap">
    <header class="page-head">
      <h1>Topics</h1>
      <p>What the essays and notes are about.</p>
    </header>
    <ul class="topics" role="list">
      {
        topics.map(({ tag, count }) => (
          <li>
            <a href={url(`/tags/${tag}/`)}>
              <span class="name">{tag}</span>
              <span class="date">
                {count} {count === 1 ? 'piece' : 'pieces'}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .topics {
    display: grid;
    gap: 0.6rem;
    padding: 0;
    list-style: none;
  }

  a {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    text-decoration: none;
  }

  .name {
    font-weight: 700;
    text-transform: capitalize;
  }

  a:hover .name {
    text-decoration: underline;
  }
</style>
