---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import TagList from '../../components/TagList.astro';
import { getPosts } from '../../lib/posts';
import { CURRENTLY_READING, PREVIOUSLY_READ } from '../../data/now';
import { TOPICS } from '../../site.config';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return TOPICS.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;
const isReading = tag === 'reading';
---

<Base title={`#${tag}`} description={`Essays and notes about ${tag}.`}>
  <div class="wrap">
    <header class="page-head">
      <h1>#{tag}</h1>
    </header>
    <div class="others">
      <TagList tags={TOPICS} current={tag} />
    </div>
    {
      posts.length ? (
        <PostList posts={posts} showKind showSummary />
      ) : (
        <p class="empty">No pieces filed under #{tag} yet.</p>
      )
    }

    {
      isReading && (
        <div class="bookshelf">
          <section class="shelf-group" aria-labelledby="reading-now-heading">
            <h2 id="reading-now-heading" class="eyebrow">
              Reading
            </h2>
            <ul class="book-list" role="list">
              {CURRENTLY_READING.map((book) => (
                <li class="book-row">
                  <span class="book-title">{book.title}</span>
                  <span class="book-author">{book.author}</span>
                </li>
              ))}
            </ul>
          </section>

          <section class="shelf-group" aria-labelledby="previously-read-heading">
            <h2 id="previously-read-heading" class="eyebrow">
              Previously read
            </h2>
            <ul class="book-list" role="list">
              {PREVIOUSLY_READ.map((book) => (
                <li class="book-row">
                  <span class="book-title">{book.title}</span>
                  <span class="book-author">{book.author}</span>
                </li>
              ))}
            </ul>
          </section>
        </div>
      )
    }
  </div>
</Base>

<style>
  .page-head h1 {
    font-style: italic;
  }

  .others {
    margin-block-end: var(--space-m);
  }

  .empty {
    padding-block: 1rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-style: italic;
  }

  .bookshelf {
    margin-block-start: var(--space-xl);
    display: grid;
    gap: var(--space-l);
  }

  .shelf-group h2 {
    padding-block-end: 0.55rem;
    border-bottom: 1px solid var(--rule);
  }

  .book-list {
    padding: 0;
    list-style: none;
  }

  .book-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-m);
    padding: 0.55rem 0.5rem;
    margin-inline: -0.5rem;
    border-bottom: 1px solid color-mix(in oklab, var(--rule) 65%, transparent);
    border-radius: 3px;
    transition: background-color 140ms ease;
  }

  .book-row:last-child {
    border-bottom: 0;
  }

  .book-row:hover {
    background: var(--hover);
  }

  .book-title {
    font-style: italic;
    color: var(--ink);
  }

  .book-author {
    font-size: var(--step--1);
    color: var(--muted);
    text-align: end;
    flex-shrink: 0;
  }

  @media (max-width: 36rem) {
    .book-row {
      flex-direction: column;
      gap: 0.15rem;
    }

    .book-author {
      text-align: start;
    }
  }
</style>
