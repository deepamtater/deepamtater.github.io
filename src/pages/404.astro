---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';

const recent = (await getPosts()).slice(0, 3);
---

<Base title="Page not found" description="This page does not exist.">
  <div class="wrap">
    <header class="page-head">
      <h1>404</h1>
      <p>
        This page wandered off. Try the <a href={url("/writing/")}>archive</a> or head back{' '}
        <a href={url("/")}>home</a>.
      </p>
    </header>
    {recent.length > 0 && <PostList posts={recent} showKind />}
  </div>
</Base>
