---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';

const recent = (await getPosts()).slice(0, 3);
---

<Base title="Page not found" description="This page doesn’t exist.">
  <div class="wrap">
    <header class="page-head">
      <h1>404 — This page wandered off.</h1>
      <p>
        It may have been renamed, or never existed. Try the{' '}
        <a href={url("/writing/")}>full archive</a> or head back <a href={url("/")}>home</a>.
      </p>
    </header>
    {recent.length > 0 && <PostList posts={recent} showKind />}
  </div>
</Base>
