---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';

const recent = (await getPosts()).slice(0, 3);
---

<Base title="Page not found" description="This page doesn’t exist.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">404</p>
      <h1>This page wandered off.</h1>
      <p>
        It may have been renamed, or never existed. Try the <a href={url("/writing/")}>full archive</a>, or
        one of these:
      </p>
    </header>
    <PostList posts={recent} showKind />
  </div>
</Base>

<style>
  .page-head h1 {
    margin-block-start: 0.4rem;
  }
</style>
