---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
---

<Base title="Page not found" description="This page isn’t in the book.">
  <div class="wrap">
    <PageTitle title="Not in the book" note="Error 404" dek="This page may have moved, or was never written." />
    <div class="leaf">
      <p class="margin">Try</p>
      <ul class="body" role="list">
        <li><a href={url('/')}>The index</a></li>
        <li><a href={url('/writing/')}>All writing</a></li>
        <li><a href={url('/tags/')}>The heads</a></li>
      </ul>
    </div>
  </div>
</Base>

<style>
  ul {
    display: grid;
    gap: 0.4rem;
    list-style: none;
  }
</style>
