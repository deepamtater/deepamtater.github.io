---
import { url } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import PageTitle from '../../components/PageTitle.astro';
import PostList from '../../components/PostList.astro';
import TagList from '../../components/TagList.astro';
import Unwritten from '../../components/Unwritten.astro';
import { entryCount, getPosts, groupByYear } from '../../lib/posts';
import { TOPICS } from '../../site.config';

const posts = await getPosts();
const years = groupByYear(posts);
const counts = Object.fromEntries(
  TOPICS.map((t) => [t, posts.filter((p) => p.data.tags.includes(t)).length]),
);
const tags = TOPICS.filter((t) => counts[t] > 0);
---

<Base title="Writing" description="Every essay and note by Dee Tater, newest first.">
  <div class="wrap">
    <PageTitle title="Writing" dek="Every essay and note, newest first." note={entryCount(posts.length)}>
      {
        tags.length > 0 && (
          <div class="filter" role="group" aria-label="Filter by head">
            <TagList tags={tags} counts={counts} filter />
            <p class="status" aria-live="polite" />
          </div>
        )
      }
    </PageTitle>

    {
      years.map(([year, items]) => (
        <section class="leaf year" data-year aria-labelledby={`y-${year}`}>
          <h2 id={`y-${year}`} class="margin">
            {year}
          </h2>
          <div class="body">
            <PostList posts={items} showKind shortDate />
          </div>
        </section>
      ))
    }

    {
      posts.length === 0 && (
        <div class="leaf">
          <p class="margin" />
          <div class="body">
            <Unwritten line="First pieces coming soon.">
              <p>
                Essays and notes will be listed here as they are finished, newest first. Follow along with the{' '}
                <a href={url('/rss.xml')}>RSS feed</a>.
              </p>
            </Unwritten>
          </div>
        </div>
      )
    }
  </div>
</Base>

<script is:inline>
  (() => {
    const chips = [...document.querySelectorAll('[data-filter]')];
    const status = document.querySelector('.filter .status');
    if (!chips.length || !status) return;

    const apply = (tag) => {
      let shown = 0;
      for (const chip of chips) chip.setAttribute('aria-pressed', String(chip.dataset.filter === tag));
      for (const year of document.querySelectorAll('[data-year]')) {
        let visible = 0;
        for (const item of year.querySelectorAll('li[data-tags]')) {
          const match = !tag || item.dataset.tags.split(' ').includes(tag);
          item.hidden = !match;
          visible += match;
        }
        year.hidden = visible === 0;
        shown += visible;
      }
      status.textContent = tag ? `${shown} filed under ${tag}. ` : '';
      if (tag) status.append(Object.assign(document.createElement('button'), { textContent: 'Show all', type: 'button', onclick: () => go(null) }));
    };

    const go = (tag) => {
      const next = new URL(location.href);
      tag ? next.searchParams.set('tag', tag) : next.searchParams.delete('tag');
      history.replaceState(null, '', next);
      apply(tag);
    };

    for (const chip of chips) {
      chip.setAttribute('role', 'button');
      chip.addEventListener('click', (event) => {
        event.preventDefault();
        go(chip.getAttribute('aria-pressed') === 'true' ? null : chip.dataset.filter);
      });
    }

    apply(new URLSearchParams(location.search).get('tag'));
  })();
</script>

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-block-start: var(--space-m);
  }

  .status {
    font-size: var(--step--1);
    font-style: italic;
    color: var(--muted);
  }

  .status :global(button) {
    border: 0;
    padding: 0;
    background: none;
    color: var(--accent);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .year + .year .body {
    padding-block-start: var(--space-m);
  }

  .year .margin {
    padding-block-start: 1.25rem;
    font-family: var(--font-text);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }
</style>
