---
import { url } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import TagList from '../../components/TagList.astro';
import { getPosts, groupByYear } from '../../lib/posts';
import { TOPICS } from '../../site.config';

const posts = await getPosts();
const years = groupByYear(posts);
const counts = Object.fromEntries(
  TOPICS.map((t) => [t, posts.filter((p) => p.data.tags.includes(t)).length]),
);
const tags = TOPICS.filter((t) => counts[t] > 0);
const description = 'Essays and short notes, newest first.';
---

<Base title="Writing" description={description}>
  <div class="wrap">
    <header class="page-head">
      <div class="head-row">
        <h1>Writing</h1>
        <nav class="kind-nav mono" aria-label="Writing format">
          <a href={url("/writing/")} aria-current="page">All</a>
          <span aria-hidden="true">·</span>
          <a href={url("/essays/")}>Essays</a>
          <span aria-hidden="true">·</span>
          <a href={url("/notes/")}>Notes</a>
        </nav>
      </div>
      <p>{description}</p>
    </header>

    {
      tags.length > 0 && (
        <div class="filter" role="group" aria-label="Topics">
          <TagList tags={tags} counts={counts} filter />
          <p class="status mono" aria-live="polite"></p>
        </div>
      )
    }

    {
      years.map(([year, items]) => (
        <section class="year" data-year aria-labelledby={`y-${year}`}>
          <h2 id={`y-${year}`} class="mono">
            {year}
          </h2>
          <PostList posts={items} showKind shortDate />
        </section>
      ))
    }
    {posts.length === 0 && <p class="empty">No essays or notes published yet.</p>}
  </div>
</Base>

<script is:inline>
  (() => {
    const chips = [...document.querySelectorAll('[data-filter]')];
    const status = document.querySelector('.filter .status');
    if (!chips.length || !status) return;

    const apply = (tag) => {
      let shown = 0;
      for (const chip of chips) chip.setAttribute('aria-pressed', String(chip.dataset.filter === tag));
      for (const year of document.querySelectorAll('[data-year]')) {
        let visible = 0;
        for (const item of year.querySelectorAll('li[data-tags]')) {
          const match = !tag || item.dataset.tags.split(' ').includes(tag);
          item.hidden = !match;
          visible += match;
        }
        year.hidden = visible === 0;
        shown += visible;
      }
      status.textContent = tag ? `${shown} in #${tag} · ` : '';
      if (tag)
        status.append(
          Object.assign(document.createElement('button'), {
            textContent: 'All',
            type: 'button',
            onclick: () => go(null),
          }),
        );
    };

    const go = (tag) => {
      const url = new URL(location.href);
      tag ? url.searchParams.set('tag', tag) : url.searchParams.delete('tag');
      history.replaceState(null, '', url);
      apply(tag);
    };

    for (const chip of chips) {
      chip.setAttribute('role', 'button');
      chip.addEventListener('click', (event) => {
        event.preventDefault();
        go(chip.getAttribute('aria-pressed') === 'true' ? null : chip.dataset.filter);
      });
    }

    apply(new URLSearchParams(location.search).get('tag'));
  })();
</script>

<style>
  .head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
  }

  .kind-nav {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    color: var(--muted);
  }

  .kind-nav a {
    color: var(--muted);
    text-decoration: none;
  }

  .kind-nav a:hover {
    color: var(--accent);
  }

  .kind-nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.24em;
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-block-end: var(--space-l);
  }

  .status {
    color: var(--muted);
  }

  .status :global(button) {
    border: 0;
    padding: 0;
    background: none;
    font: inherit;
    color: var(--accent);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .year {
    display: grid;
    grid-template-columns: 5rem 1fr;
    align-items: start;
  }

  .year + .year {
    margin-block-start: var(--space-l);
  }

  .year h2 {
    padding-block-start: 0.9rem;
    font-weight: 500;
    color: var(--muted);
  }

  .empty {
    padding-block: 1rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-style: italic;
  }

  @media (max-width: 34rem) {
    .year {
      grid-template-columns: 1fr;
    }

    .year h2 {
      padding-block: 0 0.25rem;
      border-bottom: 1px solid var(--rule);
    }
  }
</style>
