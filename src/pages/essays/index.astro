---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts('essays');
const description = 'Long-form, evergreen pieces — rewritten until they hold up.';
---

<Base title="Essays" description={description}>
  <div class="wrap">
    <header class="page-head">
      <h1>Essays</h1>
    </header>
    {
      posts.length ? (
        <PostList posts={posts} showSummary />
      ) : (
        <p class="empty">No essays published yet.</p>
      )
    }
  </div>
</Base>

<style>
  .empty {
    padding-block: 1rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-style: italic;
  }
</style>
