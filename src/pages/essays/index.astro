---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import Empty from '../../components/Empty.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts('essays');
const description = 'Long-form, evergreen pieces — rewritten until they hold up.';
---

<Base title="Essays" description={description}>
  <div class="wrap">
    <header class="page-head">
      <h1>Essays</h1>
      <p>{description}</p>
    </header>
    {posts.length ? <PostList posts={posts} showSummary /> : <Empty what="No essays" />}
  </div>
</Base>
