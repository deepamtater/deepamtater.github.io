---
import Base from '../layouts/Base.astro';
import { CURRENTLY_READING, PREVIOUSLY_READ } from '../data/now';
---

<Base title="Now" description="Current focus and reading.">
  <div class="wrap" data-article>
    <header class="page-head">
      <h1>Now</h1>
    </header>

    <div class="now-content prose">
      <section id="building">
        <h2>Building</h2>
        <p>
          <a href="https://puvio.app" rel="noopener" target="_blank">Puvio</a>, a single work record
          for career search and progression.
        </p>
      </section>

      <section id="llms">
        <h2>
          Everything about LLMs, from A to Z <span class="week">(Week 1)</span>
        </h2>
        <p>
          Rebuilding the language model stack from blank files, starting with neural networks and
          backpropagation by hand.
        </p>
      </section>

      <section id="reading">
        <h2>Reading</h2>

        <h3 class="eyebrow subhead">Currently reading</h3>
        <ul class="books" role="list">
          {
            CURRENTLY_READING.map((book) => (
              <li>
                <span class="book-title">{book.title}</span>{' '}
                <span class="book-author">{book.author}</span>
              </li>
            ))
          }
        </ul>

        <h3 class="eyebrow subhead">Read</h3>
        <ul class="books" role="list">
          {
            PREVIOUSLY_READ.map((book) => (
              <li>
                <span class="book-title">{book.title}</span>{' '}
                <span class="book-author">{book.author}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</Base>

<style>
  .now-content > section + section {
    margin-block-start: var(--space-l);
    padding-block-start: var(--space-l);
    border-top: 1px solid var(--rule);
  }

  .now-content h2 {
    margin-block-start: 0;
    font-size: var(--step-1);
    font-weight: 450;
  }

  .week {
    font-style: italic;
    font-weight: 400;
    color: var(--muted);
  }

  .subhead {
    margin-block-start: var(--space-m);
    margin-block-end: 0.65rem;
    font-weight: 500;
    color: var(--muted);
  }

  .books {
    padding: 0;
    margin-block-start: 0.5rem;
    list-style: none;
  }

  .books li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem var(--space-m);
    padding-block: 0.45rem;
  }

  .books li + li {
    margin-block-start: 0;
    border-top: 1px solid color-mix(in oklab, var(--rule) 55%, transparent);
  }

  .book-title {
    font-style: italic;
    color: var(--ink);
  }

  .book-author {
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>
