---
import Base from '../layouts/Base.astro';
import { CURRENTLY_READING, GOALS, PREVIOUSLY_READ } from '../data/now';

const focusGoals = GOALS.filter((g) => g.id !== 'reading');
---

<Base title="Now" description="Current focus and reading.">
  <div class="wrap" data-article>
    <header class="page-head">
      <h1>Now</h1>
    </header>

    <div class="spine">
      {
        focusGoals.map((goal) => (
          <section id={goal.id} class="goal-group" aria-labelledby={`goal-${goal.id}`}>
            <div class="goal-title-row">
              <h2 id={`goal-${goal.id}`}>{goal.title}</h2>
              {goal.href ? (
                <a href={goal.href} rel="noopener" target="_blank" class="horizon mono">
                  {goal.horizon}
                </a>
              ) : (
                goal.horizon && <span class="horizon mono">{goal.horizon}</span>
              )}
            </div>

            <ol class="steps" role="list">
              {goal.steps.map((step) => (
                <li class:list={['step', `step--${step.state}`]}>
                  <span class="step-marker" aria-hidden="true">
                    {step.state === 'done' ? '●' : step.state === 'active' ? '◉' : '○'}
                  </span>
                  <span class="step-label">{step.label}</span>
                  {step.state === 'active' && <span class="step-tag mono">now</span>}
                </li>
              ))}
            </ol>
          </section>
        ))
      }

      <section id="reading" class="goal-group" aria-labelledby="goal-reading">
        <div class="goal-title-row">
          <h2 id="goal-reading">Reading</h2>
        </div>

        <ol class="steps" role="list">
          {
            CURRENTLY_READING.map((book) => (
              <li class="step step--active">
                <span class="step-marker" aria-hidden="true">
                  ◉
                </span>
                <span class="book-title">{book.title}</span>
                <span class="book-author">{book.author}</span>
              </li>
            ))
          }
        </ol>

        <div class="previous-block">
          <h3 class="eyebrow">Previously read</h3>
          <ul class="book-list" role="list">
            {
              PREVIOUSLY_READ.map((book) => (
                <li class="book-row">
                  <span class="book-title">{book.title}</span>
                  <span class="book-author">{book.author}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </div>
  </div>
</Base>

<style>
  .spine {
    border-top: 1px solid var(--rule);
  }

  .goal-group {
    padding-block: var(--space-l);
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 2rem;
  }

  .goal-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem var(--space-s);
  }

  h2 {
    font-size: var(--step-1);
    font-weight: 450;
    color: var(--ink);
  }

  .horizon {
    color: var(--muted);
    text-decoration: none;
  }

  a.horizon:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .steps {
    position: relative;
    margin-block-start: var(--space-s);
    margin-inline-start: 0.35rem;
    padding-inline-start: 1.75rem;
    border-inline-start: 1px solid var(--rule);
    list-style: none;
  }

  .step {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    padding: 0.45rem 0.55rem;
    margin-inline: -0.55rem;
    border-radius: 3px;
    transition: background-color 140ms ease;
  }

  .step:hover {
    background: var(--hover);
  }

  .step-marker {
    position: absolute;
    inset-inline-start: -1.75rem;
    transform: translateX(-50%);
    width: 1.1rem;
    text-align: center;
    background: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.2;
  }

  .step--done .step-marker {
    color: var(--ink);
  }

  .step--done .step-label {
    color: var(--muted);
  }

  .step--active .step-marker {
    color: var(--accent);
  }

  .step--active .step-label {
    color: var(--ink);
    font-weight: 450;
  }

  .step--next .step-marker {
    color: var(--muted);
  }

  .step--next .step-label {
    color: var(--muted);
  }

  .step-tag {
    color: var(--accent);
    flex-shrink: 0;
  }

  .previous-block {
    margin-block-start: var(--space-l);
  }

  .previous-block h3 {
    padding-block-end: 0.55rem;
    border-bottom: 1px solid var(--rule);
  }

  .book-list {
    padding: 0;
    list-style: none;
  }

  .book-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-m);
    padding: 0.55rem 0.5rem;
    margin-inline: -0.5rem;
    border-bottom: 1px solid color-mix(in oklab, var(--rule) 65%, transparent);
    border-radius: 3px;
    transition: background-color 140ms ease;
  }

  .book-row:last-child {
    border-bottom: 0;
  }

  .book-row:hover {
    background: var(--hover);
  }

  .book-title {
    font-style: italic;
    color: var(--ink);
  }

  .book-author {
    font-size: var(--step--1);
    color: var(--muted);
    text-align: end;
    flex-shrink: 0;
  }

  @media (max-width: 36rem) {
    .step,
    .book-row {
      flex-direction: column;
      gap: 0.15rem;
    }

    .book-author {
      text-align: start;
    }
  }
</style>
