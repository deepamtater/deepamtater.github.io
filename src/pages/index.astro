---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 10);
---

<Base>
  <div class="wrap">
    <section class="intro" aria-label="Introduction">
      <h1>
        I’m Deepam. I write to understand <a href={url("/topics/startups/")}><em>startups</em></a>,{' '}
        <a href={url("/topics/engineering/")}><em>engineering</em></a>, the{' '}
        <a href={url("/topics/reading/")}><em>books</em></a> I read, and the occasional thing about{' '}
        <a href={url("/topics/life/")}><em>life</em></a>.
      </h1>
      <p>
        Writing is how I check if I actually understand something. Longer pieces go in{' '}
        <a href={url("/essays/")}>essays</a>, quick learnings go in{' '}
        <a href={url("/notes/")}>notes</a>, and late-night thoughts go in{' '}
        <a href={url("/2am/")}>2AM</a>. <a href={url("/about/")}>More about me</a>.
      </p>
    </section>

    <div class="home-columns">
      <section class="writing-col" aria-labelledby="writing-heading">
        <div class="section-head">
          <h2 id="writing-heading" class="eyebrow">
            <a href={url("/writing/")}>Writing</a>
          </h2>
        </div>
        {
          posts.length ? (
            <PostList posts={posts} showKind shortDate />
          ) : (
            <p class="empty">First essays and notes coming soon.</p>
          )
        }
      </section>

      <aside class="now-aside" aria-labelledby="now-heading">
        <div class="section-head">
          <h2 id="now-heading" class="eyebrow">
            <a href={url("/now/")}>Now</a>
          </h2>
        </div>
        <ul class="now-lines" role="list">
          <li>
            Building <a href="https://puvio.app" rel="noopener" target="_blank">Puvio</a>.
          </li>
          <li>
            Studying <a href={url("/now/#llms")}>LLMs from A to Z</a>{' '}
            <em class="week">(Week 1)</em>.
          </li>
          <li>
            Reading <a href={url("/now/#reading")}><em>Zero to One</em></a> and{' '}
            <a href={url("/now/#reading")}><em>LLM Engineer’s Handbook</em></a>.
          </li>
        </ul>
      </aside>
    </div>
  </div>
</Base>

<style>
  .intro {
    max-width: 36rem;
    margin-block: var(--space-l) var(--space-xl);
  }

  h1 {
    font-size: var(--step-2);
    font-weight: 380;
    line-height: 1.28;
    letter-spacing: -0.018em;
    text-wrap: pretty;
  }

  h1 em {
    font-style: italic;
    color: var(--accent);
  }

  h1 a {
    color: var(--accent);
    text-decoration: none;
  }

  h1 a:hover {
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .intro p {
    margin-block-start: var(--space-m);
    max-width: 54ch;
    color: var(--muted);
  }

  .home-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    gap: var(--space-xl);
    align-items: start;
  }

  .section-head h2 a {
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
    text-decoration: none;
  }

  .section-head h2 a:hover {
    color: var(--accent);
  }

  .empty {
    padding-block: 1rem;
    color: var(--muted);
    font-style: italic;
  }

  .now-lines {
    padding: 0;
    margin-block-start: 0.9rem;
    list-style: none;
    display: grid;
    gap: 0.65rem;
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--ink);
  }

  .now-lines a {
    color: var(--ink);
    text-decoration-color: color-mix(in oklab, var(--ink) 32%, transparent);
  }

  .now-lines a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .week {
    color: var(--muted);
    font-style: italic;
  }

  @media (max-width: 42rem) {
    .home-columns {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
  }
</style>
