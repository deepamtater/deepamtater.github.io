---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';

const essays = (await getPosts('essays')).slice(0, 5);
const notes = (await getPosts('notes')).slice(0, 6);
---

<Base>
  <div class="wrap">
    <section class="intro" aria-label="Introduction">
      <h1>
        I’m Deepam Tater. I write about startups, software engineering, books worth rereading, and
        questions I’m still working through.
      </h1>
      <p>
        Essays are slow and rewritten until they hold up. Notes are shorter — observations,
        technical details, and passages written down before they fade.{' '}
        <a href={url("/about/")}>More about me</a>.
      </p>
    </section>

    <section class="block" aria-labelledby="essays-heading">
      <div class="section-head">
        <h2 id="essays-heading" class="eyebrow">Essays</h2>
        <a href={url("/essays/")}>All essays →</a>
      </div>
      {
        essays.length ? (
          <PostList posts={essays} showSummary />
        ) : (
          <p class="empty">No essays published yet.</p>
        )
      }
    </section>

    <section class="block" aria-labelledby="notes-heading">
      <div class="section-head">
        <h2 id="notes-heading" class="eyebrow">Notes</h2>
        <a href={url("/notes/")}>All notes →</a>
      </div>
      {
        notes.length ? (
          <PostList posts={notes} />
        ) : (
          <p class="empty">No notes published yet.</p>
        )
      }
    </section>
  </div>
</Base>

<style>
  .intro {
    max-width: 38rem;
    margin-block: var(--space-l) var(--space-xl);
  }

  h1 {
    font-size: var(--step-2);
    font-weight: 400;
    line-height: 1.32;
    letter-spacing: -0.016em;
    text-wrap: pretty;
  }

  .intro p {
    margin-block-start: var(--space-m);
    max-width: 54ch;
    color: var(--muted);
  }

  .intro a {
    color: var(--accent);
  }

  .block + .block {
    margin-block-start: var(--space-xl);
  }

  .empty {
    padding-block: 1rem;
    color: var(--muted);
    font-style: italic;
  }
</style>
