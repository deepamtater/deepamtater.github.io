---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import AboutContent from '../components/AboutContent.astro';
import Elsewhere from '../components/Elsewhere.astro';
import Empty from '../components/Empty.astro';
import { getPosts } from '../lib/posts';

const essays = (await getPosts('essays')).slice(0, 5);
const notes = (await getPosts('notes')).slice(0, 8);
const nothing = essays.length + notes.length === 0;
---

<Base>
  <div class="wrap">
    <section class="intro" aria-label="Introduction">
      <p class="lede">
        Slow <a href={url('/essays/')}>essays</a> and quick <a href={url('/notes/')}>notes</a> on{' '}
        <a href={url('/tags/startups/')}>startups</a>, <a href={url('/tags/engineering/')}>engineering</a>,{' '}
        <a href={url('/tags/reading/')}>books</a> and <a href={url('/tags/life/')}>life</a>.
      </p>

      <div class="more">
        <details name="more" id="about">
          <summary>About</summary>
          <div class="unfold">
            <AboutContent />
            <p><a href={url('/about/')}>The full about page</a></p>
          </div>
        </details>
        <details name="more" id="elsewhere">
          <summary>Elsewhere</summary>
          <div class="unfold">
            <Elsewhere />
          </div>
        </details>
      </div>
    </section>

    {
      nothing ? (
        <section class="block" aria-labelledby="writing-heading">
          <div class="section-head">
            <h2 id="writing-heading" class="eyebrow">Writing</h2>
          </div>
          <Empty />
        </section>
      ) : (
        <>
          <section class="block" aria-labelledby="essays-heading">
            <div class="section-head">
              <h2 id="essays-heading" class="eyebrow">Essays</h2>
              <a href={url('/essays/')}>All essays</a>
            </div>
            {essays.length ? <PostList posts={essays} showSummary /> : <Empty what="No essays" />}
          </section>
          <section class="block" aria-labelledby="notes-heading">
            <div class="section-head">
              <h2 id="notes-heading" class="eyebrow">Notes</h2>
              <a href={url('/notes/')}>All notes</a>
            </div>
            {notes.length ? <PostList posts={notes} /> : <Empty what="No notes" />}
          </section>
        </>
      )
    }
  </div>
</Base>

<script is:inline>
  (() => {
    const target = document.getElementById(location.hash.slice(1));
    if (target instanceof HTMLDetailsElement) target.open = true;
    for (const d of document.querySelectorAll('details[name="more"]')) {
      d.addEventListener('toggle', () => {
        if (d.open) history.replaceState(null, '', `#${d.id}`);
        else if (![...document.querySelectorAll('details[name="more"]')].some((x) => x.open)) {
          history.replaceState(null, '', location.pathname);
        }
      });
    }
  })();
</script>

<style>
  .intro {
    max-width: 34rem;
    margin-block: var(--space-l) var(--space-xl);
  }

  .lede {
    font-size: var(--step-2);
    font-weight: 380;
    line-height: 1.3;
    letter-spacing: -0.016em;
    text-wrap: pretty;
  }

  .lede a {
    text-decoration-color: color-mix(in oklab, var(--accent) 55%, transparent);
    text-underline-offset: 0.16em;
  }

  .lede a:hover {
    text-decoration-color: var(--accent);
  }

  /* About and Elsewhere open in place, one at a time. */
  .more {
    display: grid;
    justify-items: start;
    margin-block-start: var(--space-m);
    interpolate-size: allow-keywords;
  }

  details {
    width: 100%;
  }

  summary {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding-block: 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
    list-style: none;
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* A drawn plus that turns into a minus when open. */
  summary::after {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    background:
      linear-gradient(currentColor, currentColor) center / 100% 1px no-repeat,
      linear-gradient(currentColor, currentColor) center / 1px 100% no-repeat;
    transition: background-size var(--duration-medium) var(--ease);
  }

  details[open] > summary::after {
    background-size:
      100% 1px,
      1px 0;
  }

  summary:hover,
  details[open] > summary {
    color: var(--ink);
  }

  details::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size var(--duration-medium) var(--ease),
      content-visibility var(--duration-medium) allow-discrete;
  }

  details[open]::details-content {
    block-size: auto;
  }

  .unfold {
    display: grid;
    gap: 0.8rem;
    padding-block: 0.6rem 1rem;
    color: var(--ink-2);
  }

  .block + .block {
    margin-block-start: var(--space-xl);
  }
</style>
