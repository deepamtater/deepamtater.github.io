---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';
---

<Base title="About" description="About Deepam Tater.">
  <div class="wrap">
    <header class="page-head">
      <h1>About</h1>
    </header>
    <div class="prose">
      <p>
        I’m Deepam Tater, a 22-year-old founder and fourth-year computer science undergraduate in
        Jaipur (I grew up in Bikaner). Most of my time goes into building{' '}
        <a href="https://puvio.app" rel="noopener" target="_blank">Puvio</a> and learning how
        language models work from the ground up.
      </p>
      <p>
        This site is where I keep my notes in public. <a href={url("/essays/")}>Essays</a> are
        longer pieces on <a href={url("/topics/startups/")}>startups</a>,{' '}
        <a href={url("/topics/engineering/")}>software</a>,{' '}
        <a href={url("/topics/reading/")}>books</a>, and <a href={url("/topics/life/")}>life</a>.{' '}
        <a href={url("/notes/")}>Notes</a> are shorter takeaways from the week, and{' '}
        <a href={url("/2am/")}>2AM</a> holds late-night thoughts I’m still working through.
      </p>
      <p>
        If something here is useful, or if you think I have something wrong, I’d like to hear from
        you.
      </p>

      <dl class="elsewhere">
        {
          SITE.socials.map(({ label, handle, href }) => (
            <div class="row">
              <dt>{label}</dt>
              <dd>
                <a href={href} rel="me noopener" target="_blank" class="mono">
                  {handle}
                </a>
              </dd>
            </div>
          ))
        }
        <div class="row">
          <dt>Email</dt>
          <dd class="email-cell">
            <a href={`mailto:${SITE.email}`} class="mono">{SITE.email}</a>
            <button
              type="button"
              class="copy-btn mono"
              data-copy-email={SITE.email}
              aria-label="Copy email address"
            >
              Copy
            </button>
          </dd>
        </div>
        <div class="row">
          <dt>Feed</dt>
          <dd>
            <a href={url("/rss.xml")} class="mono">RSS</a>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</Base>

<script is:inline>
  document.querySelectorAll('[data-copy-email]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-copy-email');
      if (!email) return;
      try {
        await navigator.clipboard.writeText(email);
        const original = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => {
          btn.textContent = original;
        }, 1600);
      } catch {
        location.href = `mailto:${email}`;
      }
    });
  });
</script>

<style>
  .elsewhere {
    margin-block-start: var(--space-l);
    border-top: 1px solid var(--rule);
  }

  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    padding: 0.7rem 0.5rem;
    margin-inline: -0.5rem;
    border-bottom: 1px solid var(--rule);
    border-radius: 3px;
    transition: background-color 140ms ease;
  }

  .row:hover {
    background: var(--hover);
  }

  dt {
    color: var(--muted);
    font-size: var(--step--1);
  }

  dd {
    margin: 0;
  }

  .email-cell {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .copy-btn {
    border: 0;
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    background: none;
    color: var(--muted);
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, currentColor 38%, transparent);
    text-underline-offset: 0.2em;
    transition:
      color 140ms ease,
      background-color 140ms ease;
  }

  .copy-btn:hover {
    color: var(--accent);
    background: var(--paper);
  }

  @media (max-width: 34rem) {
    .row {
      flex-direction: column;
      gap: 0.2rem;
    }
  }
</style>
