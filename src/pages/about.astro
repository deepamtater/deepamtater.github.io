---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';
---

<Base title="About" description="About Deepam Tater." pageType="ProfilePage">
  <div class="wrap">
    <header class="page-head">
      <h1>About</h1>
    </header>
    <div class="prose">
      <p>
        I’m Deepam Tater, a 22-year-old founder and fourth-year computer science undergraduate in
        Jaipur (I grew up in Bikaner). Most of my time goes into building{' '}
        <a href="https://puvio.app" rel="noopener" target="_blank">Puvio</a> and learning how
        language models work from the ground up.
      </p>
      <p>
        This site is where I keep my notes in public. <a href={url("/essays/")}>Essays</a> are
        longer pieces on <a href={url("/topics/startups/")}>startups</a>,{' '}
        <a href={url("/topics/engineering/")}>software</a>,{' '}
        <a href={url("/topics/reading/")}>books</a>, and <a href={url("/topics/life/")}>life</a>.{' '}
        <a href={url("/notes/")}>Notes</a> are shorter takeaways from the week, and{' '}
        <a href={url("/2am/")}>2AM</a> holds late-night thoughts I’m still working through.
      </p>
      <p>
        I’m not on <span class="uninstalled" data-brand="instagram">Instagram</span>,{' '}
        <span class="uninstalled" data-brand="snapchat">Snapchat</span>, or{' '}
        <span class="uninstalled" data-brand="tiktok">TikTok</span>, and I don’t watch Reels or
        Shorts. I like having a working attention span.
      </p>
      <p>
        If something here is useful, or if you think I have something wrong, write to me at{' '}
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>{' '}
        <span class="copy-wrap"
          >(<button
            type="button"
            class="copy-inline"
            data-copy-email={SITE.email}
            aria-label="Copy email address">copy</button
          >)</span
        >, or find me on <a href="https://x.com/justdeepam" rel="me noopener" target="_blank">X</a>,{' '}
        <a href="https://www.linkedin.com/in/deepamtater/" rel="me noopener" target="_blank"
          >LinkedIn</a
        >, and{' '}
        <a href="https://github.com/dimension-drifter" rel="me noopener" target="_blank">GitHub</a>.
      </p>
    </div>
  </div>
</Base>

<script is:inline>
  document.querySelectorAll('[data-copy-email]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-copy-email');
      if (!email) return;
      try {
        await navigator.clipboard.writeText(email);
        const original = btn.textContent;
        btn.textContent = 'copied';
        setTimeout(() => {
          btn.textContent = original;
        }, 1600);
      } catch {
        location.href = `mailto:${email}`;
      }
    });
  });
</script>

<style>
  .uninstalled {
    --brand: var(--ink);
    color: color-mix(in oklab, var(--brand) 75%, var(--ink));
    transition:
      color 140ms ease,
      text-decoration-color 140ms ease;
  }

  .uninstalled[data-brand='instagram'] {
    --brand: #c13584;
  }

  .uninstalled[data-brand='snapchat'] {
    --brand: #b07d00;
  }

  .uninstalled[data-brand='tiktok'] {
    --brand: #d62957;
  }

  :global([data-theme='dark']) .uninstalled[data-brand='instagram'] {
    --brand: #e15a97;
  }

  :global([data-theme='dark']) .uninstalled[data-brand='snapchat'] {
    --brand: #e5c138;
  }

  :global([data-theme='dark']) .uninstalled[data-brand='tiktok'] {
    --brand: #ff5c82;
  }

  .uninstalled:hover {
    color: var(--brand);
    text-decoration-line: line-through;
    text-decoration-thickness: 1px;
    text-decoration-color: currentColor;
  }

  .copy-wrap {
    color: var(--muted);
    font-size: var(--step--1);
    white-space: nowrap;
  }

  .copy-inline {
    border: 0;
    padding: 0;
    background: none;
    font: inherit;
    font-style: italic;
    color: var(--muted);
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, currentColor 38%, transparent);
    text-underline-offset: 0.2em;
    transition:
      color 140ms ease,
      text-decoration-color 140ms ease;
  }

  .copy-inline:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
</style>
