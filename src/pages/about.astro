---
import Base from '../layouts/Base.astro';
import AboutContent from '../components/AboutContent.astro';
import Elsewhere from '../components/Elsewhere.astro';
import { SITE } from '../site.config';
---

<Base title="About" description={`Who ${SITE.author} is and what he writes about.`}>
  <div class="wrap">
    <header class="page-head">
      <h1>About</h1>
    </header>
    <div class="prose">
      <AboutContent />
    </div>
    <section class="elsewhere" aria-labelledby="elsewhere-heading">
      <h2 id="elsewhere-heading" class="section-title">Elsewhere</h2>
      <Elsewhere variant="list" />
    </section>
  </div>
</Base>

<style>
  .elsewhere {
    max-width: var(--measure);
    margin-block-start: var(--space-l);
  }

  .elsewhere h2 {
    margin-block-end: 0.6rem;
  }
</style>
