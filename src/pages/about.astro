---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
---

<Base title="About" description="Who Dee Tater is, and what this commonplace book is for.">
  <div class="wrap">
    <PageTitle title="About" note="The keeper of this book" />

    <section class="leaf" aria-label="Biography">
      <p class="margin">Who</p>
      <div class="body prose">
        <!-- PLACEHOLDER: replace this block with Dee's bio. -->
        <div class="placeholder">
          <p>Placeholder: Dee’s bio goes here</p>
          <p>
            Two or three short paragraphs in Dee’s own words: what you work on, what you are reading, and why you
            keep this book. Edit it in <code>src/pages/about.astro</code>.
          </p>
        </div>
      </div>
    </section>

    <section class="leaf" aria-label="How the book works">
      <p class="margin">How it works</p>
      <div class="body prose">
        <p>
          A commonplace book is an old habit: copy out what is worth keeping and file it under a few heads so you can
          find it again. This one has two kinds of entry. <a href={url('/essays/')}>Essays</a> are slow, rewritten
          until they hold up. <a href={url('/notes/')}>Notes</a> are quick, written down before an idea fades.
        </p>
        <p>
          Everything is filed under four <a href={url('/tags/')}>heads</a>: startups, engineering, reading, and life.
        </p>
      </div>
    </section>

    <section class="leaf" aria-label="Elsewhere">
      <p class="margin">Elsewhere</p>
      <div class="body">
        <ul class="elsewhere" role="list">
          <li>
            <span>Email</span>
            <span class="placeholder-inline">hello@example.com (placeholder)</span>
          </li>
          <li>
            <span>Feed</span>
            <a href={url('/rss.xml')}>RSS</a>
          </li>
        </ul>
      </div>
    </section>
  </div>
</Base>

<style>
  section + section {
    margin-block-start: var(--space-l);
  }

  .elsewhere {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .elsewhere li {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--space-s);
  }

  .elsewhere li > span:first-child {
    font-style: italic;
    color: var(--muted);
  }

  .placeholder-inline {
    width: fit-content;
    padding-inline: 0.35rem;
    border: var(--hair) dashed var(--accent);
    color: var(--accent);
  }
</style>
