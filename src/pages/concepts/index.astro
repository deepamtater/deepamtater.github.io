---
import Concept from '../../layouts/Concept.astro';
import { url } from '../../lib/url';

const concepts = [
  { id: 'a', name: 'The Sentence', idea: 'The home page is one sentence; its words are the navigation.' },
  { id: 'b', name: 'Unfold', idea: 'A short list where nothing navigates away; each line opens in place.' },
  { id: 'c', name: 'Full stop', idea: 'Extreme whitespace; one persimmon period punctuates the line in view.' },
];
---

<Concept concept="a" title="Concepts">
  <main style="width: min(100% - 2.5rem, 36rem); margin: 0 auto; padding-block: 12vh;">
    <h1 style="font-size: 1.4rem; font-weight: 500;">Three directions for the home page</h1>
    <ol style="margin-block-start: 2rem; padding-inline-start: 1.2rem; display: grid; gap: 1.2rem;">
      {
        concepts.map((c) => (
          <li>
            <a href={url(`/concepts/${c.id}/`)}>{c.name}</a>
            <span style="color: var(--muted);"> — {c.idea}</span>
            <br />
            <a href={url(`/concepts/${c.id}/writing/`)} style="font-size: 0.9em; color: var(--muted);">
              Empty writing page
            </a>
          </li>
        ))
      }
    </ol>
  </main>
</Concept>
