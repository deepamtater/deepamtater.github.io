---
import Concept from '../../../layouts/Concept.astro';
import '../../../styles/concepts/a.css';
import { url } from '../../../lib/url';
import { getPosts } from '../../../lib/posts';

const essays = (await getPosts('essays')).length;
const notes = (await getPosts('notes')).length;
const gloss = (n: number) => (n === 0 ? 'none yet' : `${n} so far`);
---

<Concept concept="a">
  <main class="page">
    <p class="sentence">
      <a href={url('/about/')}>Dee Tater<span class="gloss" aria-hidden="true">about</span></a> writes slow{' '}
      <a href={url('/concepts/a/writing/')}>essays<span class="gloss" aria-hidden="true">{gloss(essays)}</span></a> and quick{' '}
      <a href={url('/concepts/a/writing/')}>notes<span class="gloss" aria-hidden="true">{gloss(notes)}</span></a> about startups, engineering, books and
      life. The first ones are <a href={url('/rss.xml')}>on the way<span class="gloss" aria-hidden="true">rss</span></a>.
    </p>
  </main>
</Concept>
