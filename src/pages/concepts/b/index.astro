---
import Concept from '../../../layouts/Concept.astro';
import '../../../styles/concepts/b.css';
import { url } from '../../../lib/url';
import { getPosts } from '../../../lib/posts';

const count = (await getPosts()).length;
---

<Concept concept="b">
  <main class="page">
    <h1>Dee Tater</h1>
    <p class="lede">Essays and notes on startups, engineering, books and life.</p>

    <div class="list">
      <details name="unfold" id="writing">
        <summary>Writing <span class="hint">{count === 0 ? 'none yet' : count}</span></summary>
        <div class="body">
          <p>Nothing is published yet. Essays get rewritten until they hold up; notes are written before an idea fades.</p>
          <p>
            The full list will live at <a href={url('/concepts/b/writing/')}>writing</a>, and new pieces arrive in the{' '}
            <a href={url('/rss.xml')}>RSS feed</a>.
          </p>
        </div>
      </details>
      <details name="unfold" id="about">
        <summary>About</summary>
        <div class="body">
          <p class="placeholder">Placeholder: Dee’s bio goes here, two or three sentences in Dee’s own words.</p>
        </div>
      </details>
      <details name="unfold" id="elsewhere">
        <summary>Elsewhere</summary>
        <div class="body">
          <p>
            <a href={url('/rss.xml')}>RSS</a> · <span class="placeholder">hello@example.com (placeholder)</span>
          </p>
        </div>
      </details>
    </div>
  </main>
</Concept>

<script is:inline>
  (() => {
    const all = [...document.querySelectorAll('details[name="unfold"]')];
    const fromHash = document.getElementById(location.hash.slice(1));
    if (fromHash && all.includes(fromHash)) fromHash.open = true;
    for (const d of all) {
      d.addEventListener('toggle', () => {
        if (d.open) history.replaceState(null, '', `#${d.id}`);
        else if (!all.some((x) => x.open)) history.replaceState(null, '', location.pathname);
      });
    }
  })();
</script>
